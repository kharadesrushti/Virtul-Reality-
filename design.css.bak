.container1{

 position: relative;

 padding-bottom: 35.25%; /* set the aspect ratio here as (height / width) * 100% */

 height: 0;

 overflow: hidden;

 max-width: 50%;

}

.container1 embed-responsive-item{
 position: absolute;

 top: 0;

 left: 0;

 width: 30%;

 height: 10%;

}
.VR {
	display:block;
	text-align:justify;
	width: 1000px ;
  margin-left: auto ;
  margin-right: auto ;

}
.col{
	color:white;
}
.back{
	background:#00000;
	position:absolute;
	
	z-index=1;
	
	}
.f{
	
	font-weight:bold;
}
.ba{
	background-color:#D3D3D3;
}