		.navbar {
  width: 100%;
}

.navbar a {
  
  padding: 12px;
  color: white;
  text-decoration: none;
  font-size: 20px;
}

.navbar a:hover {
  background-color:black;
}

.active {
  background-color:#808080;
}
.btn1{
    height: 50px;
    width: 100px;
    margin: 20px;
    float: left;
    border:0px;
    color:#fff;
    box-shadow: 0 0 1px #ccc;
    -webkit-transition-duration: 0.5s;
    -webkit-transition-timing-function: linear;
    box-shadow:0px 0 0 #31708f  inset;
}
.btn1:hover{
    -webkit-box-shadow: -100px 0 0 #FF0000 inset;
}

